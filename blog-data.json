    {
      "title": "搜尋此網誌",
      "content": "<div class=\"kraft-search-box\">    \n    <input type=\"text\" id=\"sidebar-search-input\" placeholder=\"輸入關鍵字搜尋文章...\" onkeyup=\"filterArticles()\" class=\"kraft-search-input\" />\n</div>\n\n<style>    \n    .kraft-search-box {        \n        background-color: #faf3e0; /* 復古牛皮紙內頁色 */\n        border: 1px solid #d4c4a8;        \n        padding: 12px;        \n        border-radius: 8px;        \n        box-shadow: 3px 3px 10px rgba(92, 70, 48, 0.1);    \n    }    \n    .kraft-search-input {        \n        width: 100%;        \n        background-color: #f4ebd0; /* 輸入框微深色紙張底 */\n        border: 1px solid #c2b091;        \n        color: #3d2c1e; /* 墨褐色輸入文字 */\n        padding: 8px 12px;        \n        font-size: 12px;        \n        border-radius: 4px;        \n        outline: none;        \n        box-sizing: border-box;        \n        font-family: 'Noto Serif TC', \"PMingLiU\", serif;        \n        transition: all 0.2s;    }    \n    .kraft-search-input:focus {        \n        border-color: #8c734b;        \n        box-shadow: 0 0 0 1px #8c734b;    }    \n    .kraft-search-input::placeholder {        \n        color: #8c734b; /* 復古風的提示文字顏色 */\n    }\n</style>\n\n<script>    \n    function filterArticles() {        \n        const keyword = document.getElementById('sidebar-search-input').value.toLowerCase();        \n        const mainContent = document.getElementById('main-content');                \n        // 如果不在首頁文章列表，先幫訪客導回首頁再進行搜尋篩選        \n        if (location.hash.startsWith('#article/')) {            \n            location.hash = '';        \n        }        \n        // 取得所有文章區塊元素        \n        const articles = document.querySelectorAll('main article');        \n        if (!articles.length) return;        \n        articles.forEach(article => {            \n            const text = article.innerText.toLowerCase();            \n            if (text.includes(keyword)) {                \n                article.style.display = '';            \n            } else {                \n                article.style.display = 'none';            \n            }        });    \n</script>"
    }
